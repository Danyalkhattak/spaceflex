# =============================================================================
# SPACEFLEX BACKEND - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to `.env.local` (frontend) and configure Convex deployment
# environment variables (backend) as documented below. NEVER commit real
# secrets to git.
# =============================================================================

# -----------------------------------------------------------------------------
# CONVEX (server + client)
# -----------------------------------------------------------------------------
# Public - safe to expose to the React client. Generated by `npx convex dev`.
# CONVEX_DEPLOYMENT is used by the Convex CLI only (never read by the browser).
# VITE_CONVEX_URL is what your React app reads via import.meta.env.
# (Using Create React App instead of Vite? Use REACT_APP_CONVEX_URL instead -
# see the note at the bottom of this file.)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# -----------------------------------------------------------------------------
# CLERK (auth)
# -----------------------------------------------------------------------------
# PUBLIC / CLIENT CONFIG - safe to expose to React
VITE_CLERK_PUBLISHABLE_KEY=

# SERVER SECRET - used only by Clerk's own backend / Convex JWT verification.
# Never send this to the React bundle.
CLERK_SECRET_KEY=

# Set on the Convex dashboard (Settings -> Environment Variables), NOT in
# the React app. This is the Clerk "Issuer URL" used by convex/auth.config.ts
# to verify JWTs issued by Clerk (JWT template named "convex").
CLERK_JWT_ISSUER_DOMAIN=

# -----------------------------------------------------------------------------
# CLOUDINARY (property / service images)
# -----------------------------------------------------------------------------
# PUBLIC / CLIENT CONFIG - safe to expose to React (used for unsigned/
# signed upload widget configuration only; does NOT grant delete/admin access)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# SERVER SECRETS - set ONLY in Convex dashboard environment variables.
# NEVER expose these to React / the browser bundle.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# HOW THE FRONTEND SHOULD UPLOAD IMAGES
# =============================================================================
# 1. React uploads the file directly to Cloudinary from the browser using an
#    unsigned upload preset (NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME +
#    NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET). Cloudinary returns
#    { public_id, secure_url, ... }.
# 2. React calls the Convex mutation `properties/images:addPropertyImage`
#    (admin-only) with { propertyId, cloudinaryPublicId, secureUrl, altText }.
# 3. Convex stores only the URL + public ID metadata - never binary image
#    data, and never Cloudinary secrets.
#
# If a SERVER-SIDE signed upload or deletion from Cloudinary is later needed
# (e.g. deleting the asset from Cloudinary storage, not just the Convex
# record), that must be done from a Convex action using
# CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET, never from React.
# =============================================================================

# =============================================================================
# WHICH ENV VAR PREFIX TO USE
# =============================================================================
# This file assumes a Vite-based React app (import.meta.env.VITE_*), since
# that's the most common plain-React setup. If you're using Create React App
# instead, rename every VITE_* variable above to REACT_APP_* (CRA only
# exposes vars with that prefix) and read them via process.env.REACT_APP_*.
# Nothing on the Convex backend side changes either way - these prefixes only
# affect how your bundler exposes variables to browser code.
# =============================================================================
